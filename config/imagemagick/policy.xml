<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)*>
<!ATTLIST policymap xmlns CDATA #FIXED ''>
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
  name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
  stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  The distribution ImageMagick 6 policy with a single rule relaxed.

  Debian and Ubuntu ship `path rights="none" pattern="@*"`, forbidding
  ImageMagick from reading any argument of the form @file. WordImage depends on
  exactly that: it writes the caption to a temp file and passes label:@tmpfile
  so a word like "@/etc/passwd" stays a literal caption instead of becoming a
  file read. Under the distribution policy every word image fails, which means
  the image embedded in every newsletter fails.

  Relaxing that one rule to "read" restores upstream ImageMagick's default. The
  protection that actually matters is untouched: the only path ever handed to
  ImageMagick is a temp file this app just wrote, never reader-supplied text.
  Every other distribution restriction is preserved verbatim.

  Reached through MAGICK_CONFIGURE_PATH, set on the dyno and in CI.
-->
<policymap>
  <policy domain="Undefined" rights="none"/>
  <policy domain="resource" name="memory" value="1024MiB"/>
  <policy domain="resource" name="map" value="2048MiB"/>
  <policy domain="resource" name="area" value="256MP"/>
  <policy domain="resource" name="disk" value="2GiB"/>
  <policy domain="resource" name="width" value="32KP"/>
  <policy domain="resource" name="height" value="32KP"/>
  <policy domain="path" rights="read" pattern="@*"/>
  <policy domain="delegate" rights="none" pattern="URL" />
  <policy domain="delegate" rights="none" pattern="HTTPS" />
  <policy domain="delegate" rights="none" pattern="HTTP" />
</policymap>
