<div class="player-head">
  <% if @publication.logo.attached? %>
    <%= image_tag @publication.logo, alt: @publication.name, class: "player-logo" %><br>
  <% end %>
  <div class="player-pubname"><%= @publication.name.upcase %></div>
</div>

<div class="unavailable-card">
  <h2>Your card opens from the email</h2>
  <p>Every <%= @publication.name %> email carries your key. Tap the bingo button in any issue —
    it claims <%= @publication.issue_cadence? ? "that issue's word" : "that day's word" %> and
    opens your card right here. No account, no password.</p>
  <p class="muted small">Already playing? Your card and every claimed square are safe — they live
    with your email address, not this device. One tap from any <%= @publication.name %> email
    brings it all back.</p>
</div>
