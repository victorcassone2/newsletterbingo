<div class="player-head">
  <% if @publication.logo.attached? %>
    <%= image_tag @publication.logo, alt: @publication.name, class: "player-logo" %><br>
  <% end %>
  <div class="player-pubname"><%= @publication.name.upcase %></div>
</div>

<div class="unavailable-card">
  <h2>Daily Bingo</h2>
  <p>Your bingo card lives here — one new word every day, claimed straight from the
    <%= @publication.name %> email.</p>
  <p class="muted small">This device isn&rsquo;t linked to a card yet. Open today&rsquo;s email and tap
    <strong>Claim today&rsquo;s spot</strong> — that one tap claims the square and brings your card
    up here. Bookmark it after that and it&rsquo;ll be a tap away all game.</p>
</div>
