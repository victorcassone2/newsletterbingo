<div class="player-head">
  <% if @publication.logo.attached? %>
    <%= image_tag @publication.logo, alt: @publication.name, class: "player-logo" %><br>
  <% end %>
  <div class="player-pubname"><%= @publication.name.upcase %></div>
</div>

<div class="unavailable-card">
  <% if current_participant %>
    <h2>No card yet</h2>
    <p>Your card is created the first time you tap the bingo button in a
      <%= @publication.name %> email. It claims
      <%= @publication.issue_cadence? ? "that issue's word" : "the day's word" %> and deals your card
      right here. Watch for the next one!</p>
  <% else %>
    <h2>Your card opens from the email</h2>
    <p>Tap the bingo button in the latest <%= @publication.name %> email. It claims
      <%= @publication.issue_cadence? ? "that issue's word" : "the day's word" %> and
      opens your card right here. No account, no password.</p>

    <%= form_with url: participant_session_path(@publication.public_code), class: "board-lookup" do |form| %>
      <%= form.email_field :email, placeholder: "you@example.com", required: true,
            autocomplete: "email", "aria-label": "Your newsletter email address" %>
      <%= form.submit "See my card" %>
    <% end %>
    <p class="muted small">Already playing? Enter the email your newsletter arrives at to see your card
      from any device. Looking is always open; claiming only works from the current email.</p>
  <% end %>
</div>
