<%= form_with model: sponsor, url: url, method: sponsor.persisted? ? :patch : :post do |form| %>
  <% if sponsor.errors.any? %>
    <div class="errors"><%= sponsor.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, placeholder: "Omaha Car Wash" %>
  </div>
  <div class="field">
    <%= form.label :website_url, "Website" %>
    <%= form.text_field :website_url, placeholder: "https://…" %>
  </div>
  <div class="field">
    <%= form.label :description, "Short description" %>
    <%= form.text_field :description %>
  </div>
  <div class="field">
    <%= form.label :logo %>
    <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp,image/svg+xml" %>
    <% if sponsor.persisted? && sponsor.logo.attached? %>
      <div class="hint">Current: <%= image_tag sponsor.logo, style: "max-height: 2rem; vertical-align: middle;" %></div>
    <% end %>
  </div>

  <%= form.submit sponsor.persisted? ? "Save sponsor" : "Add sponsor", class: "btn btn-primary" %>
<% end %>
