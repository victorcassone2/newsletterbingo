<%# Creating can end in a cross-origin redirect to Stripe Checkout, which
    Turbo's fetch cannot follow -- submit the classic way. %>
<%= form_with model: publication, url: url, method: publication.persisted? ? :patch : :post,
      data: publication.persisted? ? {} : { turbo: false } do |form| %>
  <% if publication.errors.any? %>
    <div class="errors"><%= publication.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Publication name" %>
    <%= form.text_field :name, placeholder: "The Daily Dispatch" %>
  </div>

  <div class="field">
    <%= form.label :timezone %>
    <%= form.select :timezone, options_for_select(timezone_options, publication.timezone) %>
    <div class="hint">Game days follow this timezone.</div>
  </div>

  <% if publication.persisted? %>
    <div class="field">
      <label><%= form.check_box :active %> Active (readers can claim and view boards)</label>
    </div>
  <% end %>

  <% if publication.persisted? %>
    <%= form.submit "Save settings", class: "btn btn-primary" %>
  <% elsif Current.account.subscribed? %>
    <%= form.submit "Create publication", class: "btn btn-primary" %>
    <p class="muted small" style="margin: .5rem 0 0;">Adds $29/month to your subscription, prorated.</p>
  <% else %>
    <%= form.submit "Create & start free trial", class: "btn btn-primary" %>
    <p class="muted small" style="margin: .5rem 0 0;">30 days free, then $29/month. Cancel anytime from Billing.</p>
  <% end %>
<% end %>
