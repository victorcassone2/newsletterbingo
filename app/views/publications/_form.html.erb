<%= form_with model: publication, url: url, method: publication.persisted? ? :patch : :post do |form| %>
  <% if publication.errors.any? %>
    <div class="errors"><%= publication.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Publication name" %>
    <%= form.text_field :name, placeholder: "Omaha Daily" %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :timezone %>
      <%= form.select :timezone, options_for_select(timezone_options, publication.timezone) %>
      <div class="hint">Game days follow this timezone.</div>
    </div>
    <div class="field">
      <%= form.label :email_merge_tag, "Subscriber email merge tag" %>
      <%= form.text_field :email_merge_tag %>
      <div class="hint">Enter the merge tag your email platform uses for the subscriber's email address, e.g. <code>{{email}}</code>, <code>|EMAIL|</code> or <code>{{ subscriber.email }}</code>. You can adjust this in Setup later.</div>
    </div>
  </div>

  <% if publication.persisted? %>
    <div class="field">
      <label><%= form.check_box :active %> Active (readers can claim and view boards)</label>
    </div>
  <% end %>

  <% if publication.persisted? %>
    <%= form.submit "Save settings", class: "btn btn-primary" %>
  <% elsif Current.account.subscribed? %>
    <%= form.submit "Create publication", class: "btn btn-primary" %>
    <div class="hint">Adds $29/month to your subscription, prorated.</div>
  <% else %>
    <%= form.submit "Create & start free trial", class: "btn btn-primary" %>
    <div class="hint">30 days free, then $29/month. Cancel anytime from Billing.</div>
  <% end %>
<% end %>
