<div class="setup-page" data-controller="tabs">
<div class="page-head">
  <div>
    <h1>Setup</h1>
    <p class="muted small">Connect Newsletter Bingo to your newsletter, brand the board, and manage settings.</p>
  </div>
</div>

<% if @publication.errors.any? %>
  <div class="errors"><%= @publication.errors.full_messages.to_sentence %></div>
<% end %>

<div class="tabs seg-tabs" role="tablist" aria-label="Setup sections">
  <button type="button" class="active" data-tabs-target="tab" data-pane="connect" data-action="tabs#select">Connect</button>
  <button type="button" data-tabs-target="tab" data-pane="branding" data-action="tabs#select">Branding</button>
  <button type="button" data-tabs-target="tab" data-pane="general" data-action="tabs#select">General</button>
  <button type="button" data-tabs-target="tab" data-pane="testing" data-action="tabs#select">Testing</button>
</div>

<div data-tabs-target="pane" data-pane="connect">
  <% check = @publication.latest_link_check %>
  <div class="card steps" data-controller="platform clipboard">
    <div class="step">
      <div class="step-head">
        <span class="step-no<%= " done" if @publication.platform %>"><%= @publication.platform ? check_glyph : "1" %></span>
        <h2><%= @publication.platform ? "Sending from #{@publication.platform.name}" : "Where do you send from?" %></h2>
      </div>
      <div class="step-body">
        <p class="hint" style="margin: 0 0 .6rem;" data-platform-target="hint"><%= @publication.platform&.hint ||
          "Pick your platform and we fill in everything it needs. There's nothing for you to look up." %></p>
        <div class="platform-chips">
          <% Platform.all.each do |platform| %>
            <button type="button" class="platform-chip<%= " active" if platform == @publication.platform %>"
              data-platform-target="chip" data-action="platform#choose"
              data-email="<%= platform.email_merge_tag %>" data-campaign="<%= platform.campaign_merge_tag %>"
              data-hint="<%= platform.hint %>"><%= platform.name %></button>
          <% end %>
        </div>

        <%= form_with model: @publication, url: account_publication_path(id: @publication.id), method: :patch,
              id: "connect-form", data: { platform_target: "form" } do |form| %>
          <%= hidden_field_tag :pane, "connect" %>
          <%# A chip's own save is silent: the step already shows the result. %>
          <%= hidden_field_tag :quiet, "", data: { platform_target: "quiet" } %>
          <details class="tag-details" <%= "open" if @publication.platform.nil? %>>
            <summary>My platform isn&rsquo;t listed, or show the tags we fill in</summary>
            <div class="field">
              <%= form.label :email_merge_tag, "Subscriber email tag" %>
              <%= form.text_field :email_merge_tag, data: { platform_target: "emailTag" } %>
              <div class="hint">The tag your platform swaps for each subscriber&rsquo;s address.
                If this is wrong, readers&rsquo; claim links won&rsquo;t work.</div>
            </div>
            <div class="field">
              <%= form.label :campaign_merge_tag, "Per-send tag" %>
              <%= form.text_field :campaign_merge_tag, data: { platform_target: "campaignTag" } %>
              <div class="hint">A tag whose value changes with every send, like a campaign id or the send
                date. Leave it blank if your platform has neither: we&rsquo;ll detect new sends automatically.</div>
            </div>
            <%= form.submit "Save tags", class: "btn btn-quiet btn-small" %>
          </details>
        <% end %>
      </div>
    </div>

    <div class="step">
      <%# A click that reached us came from an email, which means something got
          pasted. It can't tell the block from the plain link below it, so this
          checks off the step, and step 3 is the one that reports what arrived. %>
      <div class="step-head">
        <span class="step-no<%= " done" if check %>"><%= check ? check_glyph : "2" %></span>
        <h2>Paste the block into your email, once</h2>
      </div>
      <div class="step-body">
        <div class="embed-row">
          <div class="embed-preview"><%= @newsletter_block.to_html %></div>
          <div class="embed-aside">
            <p class="small" style="margin: 0 0 .25rem;">Paste it once, near the bottom of your email. It never changes.</p>
            <p class="hint" style="margin: 0 0 .8rem;">Plain email-safe tables, no JavaScript. Each subscriber
              gets a personalized claim link.</p>
            <button type="button" class="link-button with-icon" data-action="clipboard#copy">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="5.5" y="5.5" width="9" height="9" rx="1.5"/>
                <path d="M3.5 10.5h-1a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v1"/>
              </svg><span data-clipboard-target="button">Copy HTML</span>
            </button>

            <ol class="paste-steps">
              <% (@publication.platform&.paste_steps || Platform::GENERIC_PASTE_STEPS).each do |step| %>
                <li><%= step %></li>
              <% end %>
            </ol>
            <% if @publication.platform&.caveat %>
              <p class="hint"><%= @publication.platform.caveat %></p>
            <% end %>
          </div>
        </div>
        <textarea hidden readonly data-clipboard-target="source"><%= @newsletter_block.to_html %></textarea>

        <details class="link-fallback" <%= "open" if @publication.platform&.link_first? %>
          data-controller="clipboard">
          <summary>No HTML where you need it? Use a plain link instead</summary>
          <p class="small" style="margin: 0 0 .2rem;">It claims exactly the same way. It just arrives without
            the header, the sentence and the sponsor line, so fewer readers tap it.</p>
          <div class="quickadd-row">
            <%= text_field_tag :claim_link, @newsletter_block.claim_url, readonly: true, class: "mono-field",
                  "aria-label": "Claim link", data: { clipboard_target: "source" } %>
            <button type="button" class="btn btn-quiet" data-action="clipboard#copy"
              data-clipboard-target="button">Copy link</button>
          </div>
          <div class="hint">Link words of your own, or use ours: <b>Claim today&rsquo;s word &rarr;</b>.
            Insert it as a link rather than pasting the address as text: your editor would show readers the
            merge tags. Send a test afterwards and step 3 will tell you whether they survived.</div>
        </details>
      </div>
    </div>

    <div class="step">
      <div class="step-head">
        <span class="step-no<%= " done" if check&.complete? %>"><%= check&.complete? ? check_glyph : "3" %></span>
        <h2>Send yourself a test</h2>
        <span style="margin-left: auto;"><%= render "publications/test_addresses/count" %></span>
      </div>
      <div class="step-body">
        <p class="small" style="margin: 0 0 .6rem;">A bingo link clicked from a listed address opens a preview
          instead of claiming, so a test never starts your game. Test as often as you like, before your first
          send or years into it.</p>

        <div id="test-address-errors"></div>
        <%= render "publications/test_addresses/list" %>
        <%= render "publications/test_addresses/form" %>
        <div class="hint" style="margin-bottom: 1.1rem;">Your own address, anyone else on the team who tests,
          seed lists, an outside designer: every address you want previewing rather than claiming goes here.
          Don&rsquo;t add a reader&rsquo;s address; they would stop being able to claim.</div>

        <%= render "publications/link_status", publication: @publication, check: check %>
      </div>
    </div>
  </div>
</div>

<div data-tabs-target="pane" data-pane="branding" hidden>
  <div class="grid-2" data-controller="brand-preview">
    <div class="card">
      <%= form_with model: @publication, url: account_publication_path(id: @publication.id), method: :patch do |form| %>
        <%= hidden_field_tag :pane, "branding" %>
        <div class="swatch-grid">
          <%= render "publications/color_swatch", form: form, attribute: :primary_color,
                label: "Primary", property: "--brand-primary", hint: "Headings & identity" %>
          <%= render "publications/color_swatch", form: form, attribute: :accent_color,
                label: "Accent", property: "--brand-accent", hint: "Buttons & claimed squares" %>
          <%= render "publications/color_swatch", form: form, attribute: :background_color,
                label: "Background", property: "--brand-background" %>
          <%= render "publications/color_swatch", form: form, attribute: :text_color,
                label: "Text", property: "--brand-text" %>
        </div>

        <div class="field">
          <%= form.label :logo %>
          <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp,image/svg+xml",
                data: { action: "change->brand-preview#swapLogo" } %>
          <div class="hint">Shown at the top of readers&rsquo; boards in place of your publication name.</div>
          <% if @publication.logo.attached? %>
            <div class="hint">
              <%= link_to "Remove logo", account_publication_logo_path(publication_id: @publication.id),
                    data: { turbo_method: :delete }, class: "link-button" %>
            </div>
          <% end %>
        </div>

        <%= form.submit "Save branding", class: "btn btn-primary" %>
      <% end %>
    </div>

    <div class="card">
      <div class="brand-preview-frame" data-brand-preview-target="preview" style="<%= brand_style(@publication) %>">
        <div class="preview-head">
          <img class="preview-logo" data-brand-preview-target="logo" alt="Logo"
            <% if @publication.logo.attached? %>src="<%= url_for(@publication.logo) %>"<% else %>hidden<% end %>>
          <div class="preview-pubname" data-brand-preview-target="pubname"
            <%= "hidden" if @publication.logo.attached? %>><%= @publication.name.upcase %></div>
        </div>
        <div class="preview-card">
          <div class="preview-eyebrow">TODAY&rsquo;S BINGO</div>
          <div class="preview-word"><%= @preview_words.first || "FARMERS MARKET" %></div>
        </div>
        <div class="preview-grid" style="--board-cols: <%= @publication.board_size %>;">
          <% board = @preview_words.first(@publication.board_cells) %>
          <% center = BingoBoard.center_for(@publication.board_size) %>
          <% (0...@publication.board_size**2).each do |position| %>
            <% if position == center %>
              <div class="preview-square free">FREE</div>
            <% else %>
              <% word_index = center && position > center ? position - 1 : position %>
              <div class="preview-square <%= word_index % 3 == 0 ? "claimed" : "unclaimed" %>"><%= board[word_index] %></div>
            <% end %>
          <% end %>
        </div>
      </div>
      <p class="small muted" style="margin-top: .75rem;">Live preview: readers' boards and the email block
        both use these colors. Card surfaces adapt to dark backgrounds after you save.</p>
    </div>
  </div>
</div>

<div data-tabs-target="pane" data-pane="general" hidden>
  <div class="card">
    <%= form_with model: @publication, url: account_publication_path(id: @publication.id), method: :patch do |form| %>
      <%= hidden_field_tag :pane, "general" %>
      <div class="field">
        <%= form.label :name, "Publication name" %>
        <%= form.text_field :name %>
      </div>
      <div class="field">
        <%= form.label :timezone %>
        <%= form.select :timezone, options_for_select(timezone_options, @publication.timezone) %>
        <div class="hint">Game days follow this timezone.</div>
      </div>

      <div class="field">
        <%= form.label :board_size, "Game format" %>
        <p class="hint" style="margin: 0 0 .6rem;">Each card gets a random hand of the game&rsquo;s words, so not every
          word lands on every card. Takes effect with your next game; a game in progress never changes shape.</p>
        <div class="choice-cards">
          <label class="choice-card">
            <%= form.radio_button :board_size, 5 %>
            <span class="choice-card-body">
              <span class="choice-card-title">Classic</span>
              <span class="choice-card-hint">5&times;5 card &middot; 24 squares and 30 words. The full arc.</span>
            </span>
          </label>
          <label class="choice-card">
            <%= form.radio_button :board_size, 4 %>
            <span class="choice-card-body">
              <span class="choice-card-title">Compact</span>
              <span class="choice-card-hint">4&times;4 card &middot; 16 squares and 20 words. No FREE square.</span>
            </span>
          </label>
          <label class="choice-card">
            <%= form.radio_button :board_size, 3 %>
            <span class="choice-card-body">
              <span class="choice-card-title">Quick</span>
              <span class="choice-card-hint">3&times;3 card &middot; 8 squares and 12 words. A tighter arc.</span>
            </span>
          </label>
        </div>
      </div>

      <%= form.submit "Save", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="card switch-card">
    <div class="switch-row">
      <div>
        <b><%= @publication.active? ? "Publication live" : "Publication paused" %></b>
        <p class="muted small" style="margin: .15rem 0 0;">
          <% if @publication.active? %>
            Turn off to pause everything readers see: claim links and boards go dark,
            and games stop rotating until you turn it back on.
          <% else %>
            Claim links and boards are dark, and games aren't rotating.
            Turn back on to resume.
          <% end %>
        </p>
      </div>
      <%= form_with model: @publication, url: account_publication_path(id: @publication.id), method: :patch do |form| %>
        <%= hidden_field_tag :pane, "general" %>
        <label class="toggle" aria-label="Publication live">
          <%# autocomplete off: the browser must not restore a stale checked
              state over the server-rendered one on refresh %>
          <%= form.check_box :active, onchange: "this.form.requestSubmit();", autocomplete: "off" %>
          <span class="slider"></span>
        </label>
      <% end %>
    </div>
  </div>
</div>

<div data-tabs-target="pane" data-pane="testing" hidden>
  <div class="card">
    <h2>Test it before you send</h2>
    <p class="small muted">A bingo link clicked from a listed address opens a preview of the reader board
      instead of claiming, so nothing counts and your game never moves forward. An address that
      isn&rsquo;t listed claims for real.</p>
    <p class="small muted" style="margin: 0;">Your test addresses live with the rest of the setup, under
      <button type="button" class="link-button" data-pane="connect" data-action="tabs#select">Connect</button>.</p>
  </div>

  <div class="card" style="margin-top: 1.25rem;" data-controller="clipboard">
    <div class="card-head">
      <h2>Share a preview</h2>
      <button type="button" class="btn btn-small" data-action="clipboard#copy"
              data-clipboard-target="button">Copy link</button>
    </div>
    <p class="small muted">A link to a sample card that anyone can open. No email, no claim, no card of
      their own. Good for a sponsor, a designer, or anyone who just wants to see it.</p>
    <div class="quickadd-row">
      <%= text_field_tag :preview_link, preview_url(@publication), readonly: true, class: "mono-field",
            "aria-label": "Shareable preview link", data: { clipboard_target: "source" } %>
      <%= button_to "Regenerate", account_publication_preview_link_path(publication_id: @publication.id),
            method: :patch, class: "btn btn-quiet",
            form: { data: { turbo_confirm: "Every copy of the current link stops working. Send the new one to anyone who still needs it." } } %>
    </div>
    <div class="hint">Regenerating turns off every copy of the link you&rsquo;ve already sent. Readers are
      untouched: their claim links never carried this token.</div>
  </div>

</div>
</div>
