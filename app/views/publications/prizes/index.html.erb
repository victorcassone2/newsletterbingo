<div class="page-head">
  <div>
    <div class="eyebrow">Standing setup · follows every game</div>
    <h1>Sponsorship</h1>
    <p class="small muted" style="margin: .2rem 0 0;">Everything a sponsor touches: their name and
      where it appears, the standing prizes, and this game&rsquo;s prize-call giveaways.</p>
  </div>
</div>

<div class="stack">
  <div class="card" data-controller="sponsor-preview">
    <div class="card-head"><h2>Sponsor</h2></div>
    <%= form_with model: @publication, url: account_publication_sponsor_path(publication_id: @publication.id), method: :patch do |form| %>
      <div class="sponsor-row">
        <div class="field">
          <%= form.label :sponsor_name, "Sponsor name" %>
          <%= form.text_field :sponsor_name, placeholder: "e.g. Dundee Coffee",
                data: { action: "input->sponsor-preview#update" } %>
        </div>
        <%= form.submit "Save sponsor", class: "btn btn-primary" %>
      </div>
    <% end %>

    <% sponsor = @publication.sponsor_name.presence || "—" %>
    <div class="footprint">
      <div class="fp">
        <b>In the email block</b>
        <span class="sim">TODAY&rsquo;S BINGO<br>Sponsored by <span class="accent" data-sponsor-preview-target="name"><%= sponsor %></span></span>
      </div>
      <div class="fp">
        <b>On the claim receipt</b>
        <span class="sim">Today&rsquo;s game is brought to you by <span class="accent" data-sponsor-preview-target="name"><%= sponsor %></span></span>
      </div>
      <div class="fp">
        <b>On winner cards</b>
        <span class="sim">
          <% if @line_prize&.enabled? %>
            You won: <span class="accent"><%= @line_prize.name %></span>
          <% else %>
            Name the prize after the sponsor and every win says their name.
          <% end %>
        </span>
      </div>
    </div>
    <p class="small muted" style="margin: .7rem 0 0;">Every reader touchpoint, in one glance.
      The first two follow the sponsor name automatically; winner cards carry whatever the prize is named.</p>
  </div>

  <%= render "prize", prize: @line_prize %>
  <%= render "prize", prize: @blackout_prize %>

  <div class="card">
    <div class="card-head">
      <h2>🎁 Prize calls — this game</h2>
      <span class="small muted">one-day giveaways on single words</span>
    </div>
    <% if @game.nil? %>
      <p class="small muted" style="margin: 0;">No game is live yet. Once one launches, its prize
        calls roll up here.</p>
    <% else %>
      <ul class="schedule">
        <% @prize_calls.each do |call| %>
          <li>
            <span class="marker">🎁</span>
            <span class="day-no">Word <%= call.position %><% if call.issued? %> · <%= call.call_on.strftime("%-m/%-d") %><% end %></span>
            <span class="word"><%= call.label %></span>
            <% if call.prize_description.present? %><span class="small muted"><%= call.prize_description %></span><% end %>
            <span class="spacer"></span>
            <%= link_to "Edit", edit_account_publication_game_call_path(publication_id: @publication.id, game_id: call.game_id, id: call.id), class: "small" %>
          </li>
        <% end %>
        <li>
          <span class="marker">○</span>
          <span class="small muted">Mark any upcoming word as a prize call from the
            <%= link_to "schedule", account_publication_today_path(publication_id: @publication.id) %> —
            it gets the 🎁 in the email and on readers&rsquo; boards.</span>
        </li>
      </ul>
    <% end %>
  </div>
</div>
