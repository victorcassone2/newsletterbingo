<div class="page-head">
  <div>
    <div class="eyebrow">Standing setup · follows every game</div>
    <h1>Sponsorship</h1>
    <p class="small muted" style="margin: .2rem 0 0;">Everything a sponsor touches: their name and
      where it appears, the standing prizes, and this game&rsquo;s prize-call giveaways.</p>
  </div>
</div>

<div class="stack">
  <div class="card" data-controller="sponsor-preview">
    <div class="card-head"><h2>Game Sponsor</h2></div>
    <%= form_with model: @publication, url: account_publication_sponsor_path(publication_id: @publication.id), method: :patch do |form| %>
      <div class="sponsor-row">
        <div class="field">
          <%= form.label :sponsor_name, "Sponsor name" %>
          <%= form.text_field :sponsor_name, placeholder: "e.g. Dundee Coffee",
                data: { action: "input->sponsor-preview#update" } %>
        </div>
        <%= form.submit "Save sponsor", class: "btn btn-primary" %>
      </div>
    <% end %>

    <% sponsor = @publication.sponsor_name.presence || "—" %>
    <div class="footprint">
      <div class="fp">
        <b>In the email block</b>
        <span class="sim">TODAY&rsquo;S BINGO<br>Sponsored by <span class="accent" data-sponsor-preview-target="name"><%= sponsor %></span></span>
      </div>
      <div class="fp">
        <b>On the claim receipt</b>
        <span class="sim">Today&rsquo;s game is brought to you by <span class="accent" data-sponsor-preview-target="name"><%= sponsor %></span></span>
      </div>
    </div>
    <p class="small muted" style="margin: .7rem 0 0;">Both follow the sponsor name automatically.
      To put the sponsor on winner cards too, name the prizes below after them.</p>
  </div>

  <%= render "prize", prize: @line_prize %>
  <%= render "prize", prize: @blackout_prize %>
</div>
