<div class="card" id="<%= dom_id prize %>">
  <div class="card-head">
    <h2><%= prize.line? ? "Line prize" : "Blackout prize" %></h2>
    <div class="head-right">
      <% if prize.enabled? %><span class="badge badge-green">Enabled</span><% else %><span class="badge badge-gray">Off</span><% end %>
      <%= form_with model: prize, url: account_publication_prize_path(publication_id: @publication.id, id: prize.id), method: :patch do |form| %>
        <label class="toggle" aria-label="Enable <%= prize.kind %> prize">
          <%# autocomplete off: the browser must not restore a stale checked
              state over the server-rendered one on refresh %>
          <%= form.check_box :enabled, onchange: "this.form.requestSubmit();", autocomplete: "off" %>
          <span class="slider"></span>
        </label>
      <% end %>
    </div>
  </div>
  <% if defined?(@errored_prize) && @errored_prize == prize && prize.errors.any? %>
    <div class="errors"><%= prize.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="prize-grid">
    <div>
      <% if prize.enabled? %>
        <div class="prize-name"><%= prize.name %></div>
        <p class="small muted" style="margin: .3rem 0 0;">
          <% if prize.line? %>
            Awarded when a player completes their first line: any row, column, or
            diagonal. One win per player each game.
          <% else %>
            Awarded when a player claims every word on their card. One win per
            player each game.
          <% end %>
        </p>
      <% else %>
        <div class="prize-name off">No prize attached</div>
        <p class="small muted" style="margin: .3rem 0 0;">
          Winners still get the <%= prize.line? ? "BINGO!" : "BLACKOUT!" %> banner;
          flip the toggle to put a prize behind it.
        </p>
      <% end %>
    </div>

    <div class="prize-meta">
      <div class="stat">
        <b><%= @game ? prize.prize_awards.where(game: @game).count : 0 %></b>
        <span>awarded this game</span>
      </div>
      <div class="stat">
        <b><%= prize.prize_awards.count %></b>
        <span>all time</span>
      </div>
    </div>
  </div>

  <details class="edit-details" <%= "open" if defined?(@errored_prize) && @errored_prize == prize %>>
    <summary class="btn btn-quiet">Edit prize</summary>
    <%= form_with model: prize, url: account_publication_prize_path(publication_id: @publication.id, id: prize.id), method: :patch do |form| %>
      <%= form.hidden_field :enabled %>
      <div class="field-row">
        <div class="field">
          <%= form.label :name, "Prize" %>
          <%= form.text_field :name, placeholder: prize.line? ? "$25 Dundee Coffee Gift Card" : "$250 Downtown Shopping Spree" %>
        </div>
        <div class="field">
          <%= form.label :description, "Short description" %>
          <%= form.text_field :description %>
        </div>
      </div>
      <div class="field">
        <%= form.label :instructions, "Redemption instructions" %>
        <%= form.text_field :instructions, placeholder: "Show this screen at the counter." %>
      </div>
      <div class="field-row">
        <div class="field">
          <%= form.label :link_url, "Link" %>
          <%= form.text_field :link_url, placeholder: "https://…" %>
        </div>
        <div class="field">
          <%= form.label :link_text, "Link text" %>
          <%= form.text_field :link_text, placeholder: "Redeem your prize" %>
        </div>
      </div>
      <div class="field">
        <%= form.label :image, "Image (optional)" %>
        <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp" %>
      </div>

      <%= form.submit "Save prize", class: "btn btn-primary" %>
    <% end %>
  </details>
</div>
