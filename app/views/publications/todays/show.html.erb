<% if @game.nil? %>
  <div class="empty-state">
    <h1>No game yet</h1>
    <p>Start a 24-word bingo game to light up your newsletter.</p>
    <%= link_to "Create a game", new_account_publication_game_path(publication_id: @publication.id), class: "btn btn-primary" %>
    <% if @last_game %>
      <p class="small" style="margin-top: 1rem;">
        <%= link_to "How did #{@last_game.name} go? →", account_publication_game_path(publication_id: @publication.id, id: @last_game.id), class: "back-link" %>
      </p>
    <% end %>
  </div>

<% elsif @game.draft? %>
  <div class="page-head">
    <div>
      <% if @publication.issue_cadence? %>
        <div class="eyebrow">Draft · first word goes out with your next send after launch</div>
      <% else %>
        <div class="eyebrow">Draft · Day 1 is <%= @game.starts_on.strftime("%A, %B %-d") %></div>
      <% end %>
      <h1><%= @game.name %> <span class="badge badge-amber">Draft</span></h1>
    </div>
    <div class="actions">
      <%= link_to "Rename", edit_account_publication_game_path(publication_id: @publication.id, id: @game.id), class: "btn btn-quiet btn-small" %>
      <%= button_to "Launch game", account_publication_game_launch_path(publication_id: @publication.id, game_id: @game.id),
            method: :post, class: "btn btn-primary btn-small",
            form: { data: { turbo_confirm: @publication.issue_cadence? ?
              "Launch #{@game.name}? Words lock into their reveal order — the first goes out with your next send." :
              "Launch #{@game.name}? Words lock into a daily schedule." } } %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-head">
        <h2><%= Game::DAYS %> words</h2>
        <%= button_to "Shuffle all", account_publication_game_word_shuffle_path(publication_id: @publication.id, game_id: @game.id),
              method: :post, class: "btn btn-quiet btn-small" %>
      </div>
      <p class="small muted">Tap any word to replace it. The reveal order is drawn at launch.</p>
      <div class="chip-grid">
        <% @game.game_words.each do |game_word| %>
          <%= link_to edit_account_publication_game_game_word_path(publication_id: @publication.id, game_id: @game.id, id: game_word.id), class: "word-chip" do %>
            <span><%= game_word.label %><span class="swap-hint">tap to replace</span></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-head"><h2>Prizes</h2></div>
        <ul class="list">
          <% [ @game.line_prize, @game.blackout_prize ].compact.each do |prize| %>
            <li>
              <div>
                <strong><%= prize.line? ? "Line prize" : "Blackout prize" %></strong>
                <% if prize.enabled? %><span class="badge badge-green">Enabled</span><% else %><span class="badge badge-gray">Off</span><% end %>
                <div class="small muted">
                  <%= prize.enabled? ? prize.name : "No prize configured" %>
                  <% if prize.sponsor %> · Sponsored by <%= prize.sponsor.name %><% end %>
                </div>
              </div>
              <%= link_to "Edit →", edit_account_publication_game_prize_path(publication_id: @publication.id, game_id: @game.id, id: prize.id), class: "btn btn-quiet btn-small" %>
            </li>
          <% end %>
        </ul>
        <p class="small muted" style="margin-top: .5rem;">Prizes are optional — games run fine without them.</p>
      </div>

      <div class="card" style="margin-top: 1.25rem;">
        <h2>What launch does</h2>
        <% if @publication.issue_cadence? %>
          <p class="small muted">Launching locks these <%= Game::DAYS %> words into a randomized reveal order.
            A new word goes live automatically each time you send — the first click of each issue draws it.
            Nothing happens between sends.</p>
        <% else %>
          <p class="small muted">Launching locks these <%= Game::DAYS %> words into a randomized daily schedule
            starting <%= @game.starts_on.strftime("%B %-d") %>. You can still tweak any not-yet-called day afterward.</p>
        <% end %>
      </div>
    </div>
  </div>

<% elsif @call.nil? %>
  <% if @publication.issue_cadence? %>
    <div class="page-head">
      <div>
        <div class="eyebrow">Live · waiting for your first send</div>
        <h1><%= @game.name %> <span class="badge badge-green">Live</span></h1>
      </div>
      <%= link_to "Rename game", edit_account_publication_game_path(publication_id: @publication.id, id: @game.id), class: "btn btn-quiet btn-small" %>
    </div>

    <div class="grid-2">
      <div class="card">
        <h2>The first word arrives with your next newsletter</h2>
        <p class="small muted">Nothing to schedule. When your next issue goes out, the first reader's click
          draws word 1 of <%= Game::DAYS %> and claims their square — you'll see it appear here.</p>
        <p class="small muted">Make sure the embed block below is in your email template and your campaign
          merge tag is set in <%= link_to "Setup", edit_account_publication_path(id: @publication.id) %>.</p>
      </div>

      <div class="card" data-controller="clipboard">
        <div class="card-head">
          <h2>Newsletter block</h2>
          <button class="btn btn-primary btn-small" data-action="clipboard#copy" data-clipboard-target="button">Copy HTML</button>
        </div>
        <div class="embed-preview"><%= @newsletter_block.to_html %></div>
        <textarea hidden readonly data-clipboard-target="source"><%= @newsletter_block.to_html %></textarea>
        <p class="small muted" style="margin-top: .75rem;">Evergreen — paste it into your reusable template once.</p>
      </div>
    </div>

    <div class="card" style="margin-top: 1.25rem;">
      <div class="card-head"><h2>Reveal order</h2></div>
      <%= render "schedule", calls: @calls, game: @game %>
    </div>
  <% else %>
    <div class="empty-state">
      <h1><%= @game.started? ? "No call today" : "Starts soon" %></h1>
      <p>
        <% if !@game.started? %>
          <%= @game.name %> begins <%= @game.starts_on.strftime("%A, %B %-d") %>.
        <% else %>
          There's no word scheduled today — the game continues on your next send day.
        <% end %>
      </p>
    </div>

    <% if @calls&.any? %>
      <div class="card" style="margin-top: 1.25rem;">
        <div class="card-head"><h2>Schedule</h2></div>
        <%= render "schedule", calls: @calls, game: @game %>
      </div>
    <% end %>
  <% end %>

<% else %>
  <div class="page-head">
    <div>
      <% if @publication.issue_cadence? %>
        <div class="eyebrow">Current issue · went out <%= @call.call_on.strftime("%A, %B %-d") %></div>
        <h1>Word <%= @call.position %> of <%= Game::DAYS %> — <%= @game.name %></h1>
      <% else %>
        <div class="eyebrow">Today · <%= @publication.local_date.strftime("%A, %B %-d") %></div>
        <h1>Day <%= @call.position %> of <%= Game::DAYS %> — <%= @game.name %></h1>
      <% end %>
    </div>
    <%= link_to "Rename game", edit_account_publication_game_path(publication_id: @publication.id, id: @game.id), class: "btn btn-quiet btn-small" %>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="ticket">
        <div class="ticket-label"><%= @publication.issue_cadence? ? "This issue's word" : "Today's word" %> <% if @call.prize_call? %>· 🎁 prize call<% end %></div>
        <div class="ticket-word"><%= @call.label %></div>
        <% if @call.sponsor %>
          <div class="small muted" style="margin-top: .35rem;">Sponsored by <%= @call.sponsor.name %></div>
        <% end %>
      </div>

      <div class="today-meta">
        <div class="stat">
          <div class="eyebrow"><%= @publication.issue_cadence? ? "Claims this issue" : "Claims today" %></div>
          <strong><%= @claims_today %></strong>
        </div>
      </div>

      <% if @call.description.present? %>
        <p class="small" style="margin-top: .9rem;"><%= @call.description %></p>
      <% end %>
      <% if @call.link? %>
        <p class="small muted"><%= @call.link_text %> → <%= @call.link_url %></p>
      <% end %>

      <div class="today-actions">
        <%= link_to "Edit this call", edit_account_publication_game_call_path(publication_id: @publication.id, game_id: @game.id, id: @call.id), class: "btn btn-primary btn-small" %>
        <% if @call.word_changeable? %>
          <span class="badge badge-amber">Word can still change</span>
        <% elsif @publication.issue_cadence? %>
          <% if @current_issue&.rollbackable? %>
            <%= button_to "Re-queue this word", account_publication_game_issue_path(publication_id: @publication.id, game_id: @game.id, id: @current_issue.id),
                  method: :delete, class: "btn btn-quiet btn-small",
                  form: { data: { turbo_confirm: "Put #{@call.label} back in the queue? Use this if the advance came from a test send." } } %>
          <% else %>
            <span class="badge badge-gray">Word locked — sent with this issue</span>
          <% end %>
        <% else %>
          <span class="badge badge-gray">Word locked<%= " — already claimed" if @call.daily_claims.any? %></span>
        <% end %>
      </div>
    </div>

    <div class="card" data-controller="clipboard">
      <div class="card-head">
        <h2>Newsletter block</h2>
        <button class="btn btn-primary btn-small" data-action="clipboard#copy" data-clipboard-target="button">Copy HTML</button>
      </div>
      <div class="embed-preview"><%= @newsletter_block.to_html %></div>
      <textarea hidden readonly data-clipboard-target="source"><%= @newsletter_block.to_html %></textarea>
      <p class="small muted" style="margin-top: .75rem;">
        <% if @publication.issue_cadence? %>
          Evergreen — lives in your reusable template. Merge tags and details in <%= link_to "Setup", edit_account_publication_path(id: @publication.id) %>.
        <% else %>
          Paste near the bottom of today's email — each subscriber gets a personalized claim link.
          Merge tag and details live in <%= link_to "Setup", edit_account_publication_path(id: @publication.id) %>.
        <% end %>
      </p>
    </div>
  </div>

  <div class="card" style="margin-top: 1.25rem;">
    <div class="card-head">
      <h2><%= @publication.issue_cadence? ? "Reveal order" : "Schedule" %></h2>
      <% if @publication.issue_cadence? %>
        <span class="small muted"><%= Game::DAYS - @game.issued_calls.count %> words waiting</span>
      <% end %>
    </div>
    <%= render "schedule", calls: @calls, game: @game %>
  </div>

  <div class="grid-2" style="margin-top: 1.25rem;">
    <div class="card">
      <div class="card-head"><h2>Prizes</h2></div>
      <ul class="list">
        <% [ @game.line_prize, @game.blackout_prize ].compact.each do |prize| %>
          <li>
            <div>
              <strong><%= prize.line? ? "Line prize" : "Blackout prize" %></strong>
              <% if prize.enabled? %><span class="badge badge-green">Enabled</span><% else %><span class="badge badge-gray">Off</span><% end %>
              <div class="small muted">
                <%= prize.enabled? ? prize.name : "No prize configured" %>
                <% if prize.sponsor %> · Sponsored by <%= prize.sponsor.name %><% end %>
              </div>
            </div>
            <%= link_to "Edit →", edit_account_publication_game_prize_path(publication_id: @publication.id, game_id: @game.id, id: prize.id), class: "btn btn-quiet btn-small" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>Players</h2>
        <%= link_to "Analytics →", account_publication_analytics_path(publication_id: @publication.id), class: "back-link" %>
      </div>
      <div class="stat-tiles">
        <div class="stat-tile"><strong><%= @game.bingo_boards.count %></strong><span>Boards</span></div>
        <div class="stat-tile"><strong><%= @game.daily_claims.count %></strong><span>Total claims</span></div>
        <div class="stat-tile"><strong><%= @game.bingo_boards.where.not(bingo_achieved_at: nil).count %></strong><span>Bingos</span></div>
        <div class="stat-tile"><strong><%= @game.bingo_boards.where.not(blackout_achieved_at: nil).count %></strong><span>Blackouts</span></div>
      </div>
    </div>
  </div>
<% end %>
