<% unless @publication.billing_active? %>
  <div class="attention">
    <span>⏳ Your next game won't start — subscribe to keep the streak going.</span>
    <%= link_to "Subscribe", edit_account_publication_path(id: @publication.id, anchor: "billing"), class: "btn btn-small" %>
  </div>
<% end %>

<% if @game.nil? %>
  <% if @next_game %>
    <%= render "draft_review", game: @next_game %>
  <% else %>
    <div class="empty-state">
      <h1>No game yet</h1>
      <p>Add a few words to your library and refresh. We'll draft a game for you.</p>
    </div>
  <% end %>
<% else %>
  <% if @next_game %>
    <div class="tabs">
      <%= link_to "Current game", account_publication_today_path(publication_id: @publication.id),
            class: ("active" if @tab == :current) %>
      <%= link_to "Next game", account_publication_today_path(publication_id: @publication.id, tab: "next"),
            class: ("active" if @tab == :next) %>
    </div>
  <% end %>

  <% if @tab == :next %>
    <%= render "up_next", game: @next_game %>
  <% else %>
    <%= render "live_game" %>
  <% end %>
<% end %>
