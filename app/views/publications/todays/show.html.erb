<% if @publication.closed? %>
  <div class="attention">
    <span>🚫 This publication is cancelled. Readers can't reach it and no games run.</span>
    <%= link_to "Restore it", account_billing_path, class: "btn btn-small" %>
  </div>
<% elsif @publication.canceled? %>
  <div class="attention">
    <span>⏳ Cancelled: readers keep playing until <%= @publication.closes_on.strftime("%B %-d") %>,
      then this publication goes dark. No new game starts before then.</span>
    <%= link_to "Keep it", account_billing_path, class: "btn btn-small" %>
  </div>
<% elsif !@publication.billing_active? %>
  <div class="attention">
    <span>⏳ Your next game won't start. Subscribe to keep the streak going.</span>
    <%= link_to "Go to Billing", account_billing_path, class: "btn btn-small" %>
  </div>
<% end %>

<% if @game.nil? %>
  <% if @next_game %>
    <%= render "draft_review", game: @next_game %>
  <% else %>
    <div class="empty-state">
      <h1>No game yet</h1>
      <p>Add a few words to your library and refresh. We'll draft a game for you.</p>
    </div>
  <% end %>
<% else %>
  <% if @next_game %>
    <div class="tabs">
      <%= link_to "Current game", account_publication_today_path(publication_id: @publication.id),
            class: ("active" if @tab == :current) %>
      <%= link_to "Next game", account_publication_today_path(publication_id: @publication.id, tab: "next"),
            class: ("active" if @tab == :next) %>
    </div>
  <% end %>

  <% if @tab == :next %>
    <%= render "up_next", game: @next_game %>
  <% else %>
    <%= render "live_game" %>
  <% end %>
<% end %>
