<div class="page-head">
  <h1>Analytics</h1>
</div>

<div class="stat-tiles" style="margin-bottom: 1.25rem;">
  <div class="stat-tile"><strong><%= @analytics.total_participants %></strong><span>Total participants</span></div>
  <div class="stat-tile"><strong><%= @analytics.claims_today %></strong><span>Claims today</span></div>
  <div class="stat-tile"><strong><%= @analytics.claims_last_7_days %></strong><span>Claims, 7 days</span></div>
  <div class="stat-tile"><strong><%= @analytics.claims_last_30_days %></strong><span>Claims, 30 days</span></div>
</div>

<% if @game %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <h2><%= @game.name %> — Day <%= @game.days_elapsed %> of <%= Game::DAYS %></h2>
    <div class="stat-tiles" style="margin: .75rem 0 1.25rem;">
      <div class="stat-tile"><strong><%= @analytics.game_participants(@game) %></strong><span>Players</span></div>
      <div class="stat-tile"><strong><%= @analytics.participation_rate_today(@game) %>%</strong><span>Claimed today</span></div>
      <div class="stat-tile"><strong><%= @analytics.perfect_participation_count(@game) %></strong><span>Perfect so far</span></div>
      <div class="stat-tile"><strong><%= @analytics.bingo_winners(@game) %></strong><span>Bingo winners</span></div>
      <div class="stat-tile"><strong><%= @analytics.line_prizes_awarded(@game) %></strong><span>Line prizes</span></div>
      <div class="stat-tile"><strong><%= @analytics.blackout_prizes_awarded(@game) %></strong><span>Blackout prizes</span></div>
    </div>

    <h3>Claims per day</h3>
    <table class="simple">
      <thead><tr><th>Day</th><th>Word</th><th>Claims</th></tr></thead>
      <tbody>
        <% today = @publication.local_date %>
        <% @analytics.claims_per_day(@game).each do |call, count| %>
          <% next if call.call_on > today %>
          <tr>
            <td>Day <%= call.day_number %> · <%= call.call_on.strftime("%-m/%-d") %></td>
            <td><%= call.label %><% if call.sponsor %> <span class="badge badge-gray"><%= call.sponsor.name %></span><% end %></td>
            <td><%= count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% sponsor_stats = @analytics.sponsor_stats %>
<% if sponsor_stats.any? %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <h2>Sponsors</h2>
    <table class="simple">
      <thead><tr><th>Sponsor</th><th>Daily calls</th><th>Claims</th><th>Link clicks</th></tr></thead>
      <tbody>
        <% sponsor_stats.each do |row| %>
          <tr>
            <td><%= row[:sponsor].name %></td>
            <td><%= row[:calls] %></td>
            <td><%= row[:claims] %></td>
            <td><%= row[:link_clicks] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% @completed_games.each do |game| %>
  <% summary = @analytics.completed_game_summary(game) %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <h2><%= game.name %> <span class="badge badge-gray">Completed</span></h2>
    <div class="stat-tiles" style="margin-top:.75rem;">
      <div class="stat-tile"><strong><%= summary[:participants] %></strong><span>Players</span></div>
      <div class="stat-tile"><strong><%= summary[:average_claimed_days] %></strong><span>Avg days claimed</span></div>
      <div class="stat-tile"><strong><%= summary[:median_claimed_days] %></strong><span>Median days</span></div>
      <div class="stat-tile"><strong><%= summary[:bingo_percent] %>%</strong><span>Reached bingo</span></div>
      <div class="stat-tile"><strong><%= summary[:line_prizes] %></strong><span>Line prizes</span></div>
      <div class="stat-tile"><strong><%= summary[:blackouts] %> (<%= summary[:blackout_percent] %>%)</strong><span>Blackouts</span></div>
    </div>
  </div>
<% end %>
