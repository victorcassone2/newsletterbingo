<%= render "goal" %>

<div class="card quickadd" data-controller="word-add">
  <%= form_with model: @word, url: account_publication_words_path(publication_id: @publication.id),
        data: { action: "turbo:submit-end->word-add#reset" } do |form| %>
    <%= form.text_field :label, placeholder: "Add a word and press Enter. It lands in the pool instantly",
          maxlength: 40, autocomplete: "off", autofocus: @filter == "custom",
          data: { word_add_target: "input" } %>
  <% end %>
  <div id="word-errors"></div>
  <div class="qa-hints">
    <span>Need ideas?</span>
    <% { "Neighborhoods" => "e.g. DUNDEE, BENSON, FLORENCE…",
         "Rival teams" => "e.g. JAYHAWKS, CYCLONES…",
         "Local legends" => "the names only your readers know",
         "Annual events" => "e.g. TACO RIDE, COLLEGE WORLD SERIES…",
         "Inside jokes" => "the words only your readers get" }.each do |category, prompt| %>
      <button type="button" class="qa-hint" data-action="word-add#hint"
              data-word-add-placeholder-param="<%= prompt %>"><%= category %></button>
    <% end %>
  </div>
</div>

<div data-controller="cloud-filter">
  <div class="filter-row">
    <div class="tabs" style="margin: 0;">
      <%= link_to "My words (#{@publication.words.active.count})",
            account_publication_words_path(publication_id: @publication.id),
            class: ("active" if @filter == "custom") %>
      <%= link_to "System library (#{Word.system.active.count})",
            account_publication_words_path(publication_id: @publication.id, filter: "system"),
            class: ("active" if @filter == "system") %>
    </div>
    <input type="search" placeholder="Filter as you type…" autocomplete="off"
           data-action="input->cloud-filter#filter">
    <span class="count-note" data-cloud-filter-target="count"></span>
  </div>

  <% if @filter == "system" %>
    <div class="cloud-group">
      <h3>Fill in when your custom pool runs short; custom words are always picked first</h3>
      <div class="cloud">
        <%= render partial: "chip", collection: @words, as: :word %>
      </div>
    </div>
  <% else %>
    <% in_game, rest = @words.partition { |word| @in_game_ids.include?(word.id) } %>
    <% archived, ready = rest.partition(&:archived?) %>

    <% if in_game.any? %>
      <div class="cloud-group">
        <h3>In the current game</h3>
        <div class="cloud">
          <% in_game.each do |word| %>
            <%= render "chip", word: word, in_game: true, uses: @use_counts.fetch(word.id, 0) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="cloud-group">
      <h3>Waiting for the next game</h3>
      <div class="cloud" id="ready-cloud">
        <% ready.each do |word| %>
          <%= render "chip", word: word, uses: @use_counts.fetch(word.id, 0) %>
        <% end %>
        <% if ready.empty? %>
          <% if in_game.any? %>
            <p class="small muted" style="margin: 0;">Every word you've added is in the current
              game. Add more and future games draw from a deeper pool.</p>
          <% else %>
            <p class="small muted" style="margin: 0;">Your pool is empty. Add the words only your
              readers would recognize, and games start feeling like yours.</p>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if archived.any? %>
      <div class="cloud-group">
        <h3>Archived: never picked for games</h3>
        <div class="cloud">
          <% archived.each do |word| %>
            <%= render "chip", word: word, uses: @use_counts.fetch(word.id, 0) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
