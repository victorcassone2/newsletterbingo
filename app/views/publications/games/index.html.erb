<div class="page-head">
  <h1>Games</h1>
  <% if @publication.open_game.nil? %>
    <%= link_to "New game", new_account_publication_game_path(publication_id: @publication.id), class: "btn btn-primary" %>
  <% end %>
</div>

<% if @games.any? %>
  <div class="card">
    <ul class="list">
      <% @games.each do |game| %>
        <li>
          <div>
            <%= link_to game.name, account_publication_game_path(publication_id: @publication.id, id: game.id) %>
            <% if game.active? %><span class="badge badge-green">Live — Day <%= game.days_elapsed %> of <%= Game::DAYS %></span>
            <% elsif game.draft? %><span class="badge badge-amber">Draft</span>
            <% else %><span class="badge badge-gray">Completed</span><% end %>
            <div class="small muted"><%= game.starts_on.strftime("%b %-d") %> – <%= game.ends_on.strftime("%b %-d, %Y") %></div>
          </div>
          <%= link_to "Open →", account_publication_game_path(publication_id: @publication.id, id: game.id), class: "btn btn-quiet btn-small" %>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="card" style="text-align:center; padding: 3rem 1.5rem;">
    <h2>Start your first game</h2>
    <p class="muted">A game runs exactly 24 days — one word per day, one click per reader.</p>
    <%= link_to "New game", new_account_publication_game_path(publication_id: @publication.id), class: "btn btn-primary" %>
  </div>
<% end %>
