<div class="page-head">
  <div>
    <div class="eyebrow">Day <%= @call.day_number %> · <%= @call.call_on.strftime("%A, %B %-d") %></div>
    <h1><%= @call.label %></h1>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Call content</h2>
    <p class="small muted">Shown to readers <em>after</em> they claim — never in the email itself.</p>
    <%= form_with model: @call, url: account_publication_game_call_path(publication_id: @publication.id, game_id: @game.id, id: @call.id, from: params[:from]), method: :patch do |form| %>
      <% if @call.errors.any? %>
        <div class="errors"><%= @call.errors.full_messages.to_sentence %></div>
      <% end %>

      <div class="field">
        <%= form.label :description, "Short description" %>
        <%= form.text_area :description, rows: 3, placeholder: "Papillion Farmers Market is open tonight from 5–8 PM with local vendors, food and live music." %>
      </div>
      <div class="field-row">
        <div class="field">
          <%= form.label :link_url, "Destination link" %>
          <%= form.text_field :link_url, placeholder: "https://…" %>
        </div>
        <div class="field">
          <%= form.label :link_text, "Link text" %>
          <%= form.text_field :link_text, placeholder: "See vendors and details" %>
        </div>
      </div>
      <div class="field">
        <%= form.label :sponsor_id, "Sponsor" %>
        <%= form.select :sponsor_id, options_from_collection_for_select(@sponsors, :id, :name, @call.sponsor_id), include_blank: "No sponsor" %>
      </div>
      <div class="field">
        <label><%= form.check_box :prize_call %> Prize call — show a 🎁 in the newsletter block</label>
      </div>
      <div class="field">
        <%= form.label :prize_description, "Prize call description (optional)" %>
        <%= form.text_field :prize_description, placeholder: "First 50 claims get a free coffee!" %>
      </div>

      <%= form.submit "Save call", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="card">
    <h2>Today's word</h2>
    <% if @call.word_changeable? %>
      <p class="small muted">This word hasn't been called or claimed yet, so it can still change.</p>

      <% if @swappable_calls.any? %>
        <%= form_with url: account_publication_game_call_word_path(publication_id: @publication.id, game_id: @game.id, call_id: @call.id, from: params[:from]), method: :patch do %>
          <div class="field">
            <%= label_tag :swap_call_id, "Swap with another scheduled word" %>
            <%= select_tag :swap_call_id, options_for_select(@swappable_calls.map { |c| [ "#{c.label} (Day #{c.day_number})", c.id ] }), include_blank: "Choose a word…" %>
          </div>
          <%= submit_tag "Swap words", class: "btn btn-quiet" %>
        <% end %>
        <hr style="border: none; border-top: 1px solid var(--line); margin: 1.25rem 0;">
      <% end %>

      <%= form_with url: account_publication_game_call_word_path(publication_id: @publication.id, game_id: @game.id, call_id: @call.id, from: params[:from]), method: :patch do %>
        <div class="field">
          <%= label_tag :word_id, "Replace with a word from the library" %>
          <%= select_tag :word_id, options_from_collection_for_select(@eligible_replacements, :id, :label), include_blank: "Choose a word…" %>
          <div class="hint">Swaps the new word into every player's board in this square's place.</div>
        </div>
        <%= submit_tag "Replace word", class: "btn btn-quiet" %>
      <% end %>
    <% else %>
      <p class="small muted">
        <% if @call.daily_claims.any? %>
          Readers have already claimed this word today, so it's locked.
        <% else %>
          This word has been called and is part of game history.
        <% end %>
      </p>
    <% end %>
  </div>
</div>
