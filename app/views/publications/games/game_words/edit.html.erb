<p><%= link_to "← Back to #{@game.name}", account_publication_today_path(publication_id: @publication.id), class: "back-link" %></p>

<div class="page-head">
  <div>
    <div class="eyebrow">Replace a word</div>
    <h1><%= @game_word.label %></h1>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Pick its replacement</h2>
    <%= form_with url: edit_account_publication_game_game_word_path(publication_id: @publication.id, game_id: @game.id, id: @game_word.id),
          method: :get, data: { turbo_frame: "_top" } do %>
      <span style="display: flex; gap: .5rem;">
        <%= text_field_tag :q, params[:q], placeholder: "Search the library…", style: "width: 14rem;" %>
        <%= submit_tag "Search", class: "btn btn-quiet btn-small" %>
      </span>
    <% end %>
  </div>

  <% if @choices.any? %>
    <div class="picker-grid">
      <% @choices.each do |word| %>
        <%= button_to word.label,
              account_publication_game_game_word_path(publication_id: @publication.id, game_id: @game.id, id: @game_word.id),
              method: :patch, params: { word_id: word.id }, class: "picker-choice" %>
      <% end %>
    </div>
  <% else %>
    <p class="muted">No words match<%= " “#{params[:q]}”" if params[:q].present? %>.
      <%= link_to "Add a custom word", account_publication_words_path(publication_id: @publication.id) %> to grow the library.</p>
  <% end %>
</div>
