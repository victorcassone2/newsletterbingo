<p><%= link_to "← All games", account_publication_games_path(publication_id: @publication.id), class: "back-link" %></p>

<div class="page-head">
  <div>
    <div class="eyebrow">Game history</div>
    <h1><%= game_label(@game) %> <span class="badge badge-gray">Completed</span></h1>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head"><h2>Words called</h2></div>
    <%= render "publications/todays/schedule", calls: @calls, game: @game %>
  </div>

  <div>
    <div class="card">
      <div class="card-head"><h2>Prizes awarded</h2></div>
      <ul class="list">
        <% { "Line prize" => @game.prize_awards.line, "Blackout prize" => @game.prize_awards.blackout }.each do |label, awards| %>
          <li>
            <div>
              <strong><%= label %></strong>
              <div class="small muted">
                <% if awards.any? %>
                  <%= awards.count %> awarded · <%= awards.map(&:prize_name).uniq.to_sentence %>
                <% else %>
                  None awarded
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card" style="margin-top: 1.25rem;">
      <div class="card-head"><h2>Players</h2></div>
      <div class="stat-tiles">
        <div class="stat-tile"><strong><%= @game.bingo_boards.count %></strong><span>Boards</span></div>
        <div class="stat-tile"><strong><%= @game.daily_claims.count %></strong><span>Total claims</span></div>
        <div class="stat-tile"><strong><%= @game.bingo_boards.where.not(bingo_achieved_at: nil).count %></strong><span>Bingos</span></div>
        <div class="stat-tile"><strong><%= @game.bingo_boards.where.not(blackout_achieved_at: nil).count %></strong><span>Blackouts</span></div>
      </div>
    </div>
  </div>
</div>
