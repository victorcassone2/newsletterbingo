<h1>New game</h1>
<p class="muted">Every game runs exactly <%= Game::DAYS %> days. We'll pick <%= Game::DAYS %> words for you — you can shuffle or replace them before launch.</p>

<div class="card">
  <%= form_with model: @game, url: account_publication_games_path(publication_id: @publication.id) do |form| %>
    <% if @game.errors.any? %>
      <div class="errors"><%= @game.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="field-row">
      <div class="field">
        <%= form.label :name, "Game name" %>
        <%= form.text_field :name, placeholder: "Summer Bingo" %>
      </div>
      <div class="field">
        <%= form.label :starts_on, "Day 1" %>
        <%= form.date_field :starts_on %>
        <div class="hint">Day <%= Game::DAYS %> lands <%= Game::DAYS - 1 %> days later.</div>
      </div>
    </div>

    <%= form.submit "Create game", class: "btn btn-primary" %>
  <% end %>
</div>
