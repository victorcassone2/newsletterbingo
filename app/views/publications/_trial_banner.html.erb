<%# Rendered from the layout on every publication page while the account's
    free trial runs: the first-charge date, nothing to do. %>
<% if Current.account.trialing? && !Current.account.cancel_scheduled? %>
  <div class="trial-banner">
    <span>✨ Free trial: your first charge of $<%= Current.account.monthly_price %> is
      <%= Current.account.subscription_current_period_end&.strftime("%B %-d, %Y") %>.</span>
    <%= link_to "Billing", account_billing_path %>
  </div>
<% end %>
