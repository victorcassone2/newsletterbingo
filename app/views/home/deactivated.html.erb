<div class="auth-wrap">
  <%= image_tag "logo.svg", alt: "Newsletter Bingo", class: "auth-logo" %>
  <h1 class="auth-title">Account deactivated</h1>
  <div class="card">
    <p>Your account has been deactivated by its owner.</p>
    <p class="small muted">Contact an account owner if you think this is a mistake.</p>
    <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-quiet" %>
  </div>
</div>
