<div class="page-head">
  <div>
    <h1>Billing</h1>
    <p class="muted small">One subscription: $29/month for each publication you run.</p>
  </div>
</div>

<% if @page.total.positive? %>
  <%# Only the two states the publisher has to act on get a banner of their
      own. Everything else is a line under the list's heading, because the
      list is the bill. %>
  <% case Current.account.billing_state when :payment_problem %>
    <div class="attention">
      <span>💳 Your last payment didn't go through. Stripe is retrying your card; update it to keep your games rotating.</span>
      <%= button_to "Update card", account_billing_portal_path, class: "btn btn-small",
            form: { data: { turbo: false } } %>
    </div>
  <% when :inactive %>
    <div class="attention">
      <span>⏳ No subscription running. Games that are live finish out, but the next ones won't start.</span>
      <%= button_to subscription_start_label, account_billing_subscription_path, class: "btn btn-small",
            form: { data: { turbo: false } } %>
    </div>
  <% end %>

  <%# One line per publication, because each one is a $29 unit on the single
      subscription. Canceling one takes it off the next invoice and darkens it
      when the paid period runs out; the rest keep running. %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <div class="card-head">
      <div>
        <b>Your publications</b>
        <p class="muted small" style="margin: .35rem 0 0;"><%= billing_summary %></p>
      </div>
      <% if Current.account.subscribed? %>
        <div class="menu" data-controller="menu">
          <button type="button" class="menu-button menu-button-plain" data-action="click->menu#toggle"
                  aria-label="More billing options">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM22 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
            </svg>
          </button>
          <div class="menu-panel" data-menu-target="panel" hidden>
            <div class="menu-group">
              <% if Current.account.cancel_scheduled? %>
                <%= button_to "Keep my subscription", account_billing_subscription_cancellation_path,
                      method: :delete, class: "menu-item", form: { class: "menu-form" } %>
              <% else %>
                <%= button_to "Cancel all subscriptions", account_billing_subscription_cancellation_path,
                      class: "menu-item", form: { class: "menu-form" },
                      data: { turbo_confirm: "Cancel your whole subscription? Every publication stops " \
                        "rotating games when the paid period ends." } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <ul class="list">
      <%= render partial: "publication", collection: @page.records,
            locals: { page_number: @page.number } %>
    </ul>
    <% if @page.multiple? %>
      <div class="pagination">
        <span class="small muted">
          Showing <%= @page.range %> of <%= pluralize(@page.total, "publication") %>
        </span>
        <span class="pagination__links">
          <% unless @page.first? %>
            <%= link_to "Previous", account_billing_path(page: @page.previous_number),
                  class: "btn btn-quiet btn-small" %>
          <% end %>
          <% unless @page.last? %>
            <%= link_to "Next", account_billing_path(page: @page.next_number),
                  class: "btn btn-quiet btn-small" %>
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <b>Nothing to bill yet</b>
    <p class="muted small" style="margin: .35rem 0 0;">Create your first publication and your
      30-day free trial starts with it.</p>
  </div>
<% end %>

<%# Never subscribed means no invoices and nothing to manage: hide the portal
    card so starting the trial stays the page's one action. A lapsed account
    keeps it for its past invoices. %>
<% if Current.account.stripe_subscription_id.present? && Current.account.stripe_customer_id.present? %>
  <div class="card" style="margin-bottom: 1.25rem;">
    <b>Payment method &amp; invoices</b>
    <p class="muted small" style="margin: .35rem 0 .8rem;">
      Update your card, change the billing email, or download invoices on Stripe's
      secure billing portal.
    </p>
    <%= button_to "Manage billing info", account_billing_portal_path, class: "btn btn-primary",
          form: { data: { turbo: false } } %>
  </div>
<% end %>
