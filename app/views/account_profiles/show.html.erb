<div class="page-head">
  <h1><%= Current.account.name %></h1>
</div>

<div class="card">
  <h2>People</h2>
  <ul class="list">
    <% @memberships.each do |membership| %>
      <li>
        <span>
          <%= membership.user.email_address %>
          <% if membership.user == Current.user %><span class="small muted">(you)</span><% end %>
        </span>
        <span class="people-row-meta">
          <% if @owner && !membership.last_owner? %>
            <% if membership.owner? %>
              <%= button_to "Make member", account_membership_path(id: membership.id), method: :patch,
                    params: { membership: { role: "member" } }, class: "link-button" %>
            <% else %>
              <%= button_to "Make owner", account_membership_path(id: membership.id), method: :patch,
                    params: { membership: { role: "owner" } }, class: "link-button",
                    form: { data: { turbo_confirm: "Make #{membership.user.email_address} an owner? Owners can manage people and deactivate the account." } } %>
            <% end %>
            <% if membership.user == Current.user %>
              <%= button_to "Leave", account_membership_path(id: membership.id), method: :delete,
                    class: "link-button",
                    form: { data: { turbo_confirm: "Leave #{Current.account.name}? You'll lose access unless someone invites you back." } } %>
            <% else %>
              <%= button_to "Remove", account_membership_path(id: membership.id), method: :delete,
                    class: "link-button",
                    form: { data: { turbo_confirm: "Remove #{membership.user.email_address} from #{Current.account.name}?" } } %>
            <% end %>
          <% end %>
          <span class="badge <%= membership.owner? ? "badge-green" : "badge-gray" %>"><%= membership.role.capitalize %></span>
        </span>
      </li>
    <% end %>
    <% @invitations.each do |invitation| %>
      <li>
        <span class="muted"><%= invitation.email_address %></span>
        <span class="people-row-meta">
          <%= button_to "Cancel invitation", account_invitation_path(id: invitation.id), method: :delete,
                class: "link-button" %>
          <span class="badge badge-amber">Invited</span>
        </span>
      </li>
    <% end %>
  </ul>

  <div class="people-invite">
    <%= form_with model: @invitation, url: account_invitations_path do |form| %>
      <div class="field-row" style="align-items: flex-end;">
        <div class="field" style="margin-bottom: 0;">
          <%= form.label :email_address, "Invite someone by email" %>
          <%= form.email_field :email_address, placeholder: "teammate@example.com", required: true %>
        </div>
        <%= form.submit "Send invitation", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<% if @owner %>
  <div class="card" style="margin-top: 1.5rem;">
    <h2>Deactivate account</h2>
    <% if Current.account.deactivated? %>
      <p class="small muted" style="max-width: 36rem;">
        This account is deactivated. Owners, including you, can still sign in;
        members are locked out until an owner reactivates it.
      </p>
      <%= button_to "Reactivate account", account_deactivation_path, method: :delete, class: "btn btn-quiet" %>
    <% else %>
      <p class="small muted" style="max-width: 36rem;">
        Puts the account on ice. Members lose access, but as an owner you keep yours
        and can reactivate at any time; no need to hand off ownership first.
      </p>
      <%= button_to "Deactivate account", account_deactivation_path, method: :post, class: "btn btn-danger",
            form: { data: { turbo_confirm: "Deactivate #{Current.account.name}? Members will lose access until an owner reactivates it." } } %>
    <% end %>
  </div>
<% end %>
