<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Newsletter Bingo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#F59E0B">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <% if authenticated? && Current.account %>
      <header class="topbar">
        <div class="topbar-inner">
          <%= link_to account_publications_path(account_id: Current.account.id), class: "topbar-brand" do %>
            <%= image_tag "logo.svg", alt: "Newsletter Bingo", class: "brand-logo" %>
          <% end %>
          <nav class="topbar-nav">
            <div class="menu" data-controller="menu">
              <button type="button" class="menu-button" data-action="click->menu#toggle"
                      aria-label="Open account menu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class="menu-panel" data-menu-target="panel" hidden>
                <div class="menu-head">
                  <div class="menu-account"><%= Current.account.name %></div>
                  <div class="menu-user"><%= Current.user.email_address %></div>
                </div>
                <div class="menu-group">
                  <%= link_to "Publications", account_publications_path(account_id: Current.account.id), class: "menu-item" %>
                  <%= link_to "Billing", account_billing_path(account_id: Current.account.id), class: "menu-item" %>
                  <%= link_to "People", account_account_profile_path(account_id: Current.account.id), class: "menu-item" %>
                </div>
                <div class="menu-group">
                  <%= button_to "Sign out", session_path, method: :delete,
                        class: "menu-item", form: { class: "menu-form" } %>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </header>

      <% if @publication&.persisted? %>
        <nav class="pubnav">
          <div class="pubnav-inner">
            <%= link_to "&larr;".html_safe, account_publications_path(account_id: Current.account.id),
                  class: "pubnav-back", "aria-label": "Back to publications" %>
            <span class="pubnav-name"><%= @publication.name %></span>
            <div class="pubnav-links">
              <%= nav_link_to "Games", account_publication_today_path(publication_id: @publication.id),
                    active: controller_name == "todays" || controller_path.include?("games") %>
              <%= nav_link_to "Sponsorship", account_publication_prizes_path(publication_id: @publication.id),
                    active: controller_path == "publications/prizes" || controller_path == "publications/sponsors" %>
              <%= nav_link_to "Library", account_publication_words_path(publication_id: @publication.id),
                    active: controller_path.include?("words") && !controller_path.include?("games") %>
              <%= nav_link_to "Analytics", account_publication_analytics_path(publication_id: @publication.id), active: controller_name == "analytics" %>
              <%= nav_link_to "Setup", edit_account_publication_path(id: @publication.id), active: controller_path == "publications" && action_name == "edit" %>
            </div>
          </div>
        </nav>
      <% end %>
    <% end %>

    <main class="admin-main">
      <% if authenticated? && Current.account&.deactivated? %>
        <div class="flash flash-alert">This account is deactivated; members can't access it. Reactivate it from the People page.</div>
      <% end %>
      <% if authenticated? && Current.account && @publication&.persisted? %>
        <%= render "publications/trial_banner" %>
      <% end %>
      <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
