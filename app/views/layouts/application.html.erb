<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Newsletter Bingo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <% if authenticated? && Current.account %>
      <header class="topbar">
        <div class="topbar-inner">
          <%= link_to account_publications_path(account_id: Current.account.id), class: "topbar-brand" do %>
            <span class="brand-dot"></span> Newsletter Bingo
          <% end %>
          <nav class="topbar-nav">
            <%= nav_link_to "Publications", account_publications_path(account_id: Current.account.id),
                  active: controller_name == "publications" && controller_path == "publications" %>
            <%= nav_link_to "Billing", account_billing_path(account_id: Current.account.id),
                  active: controller_path == "billings" %>
            <%= nav_link_to "People", account_account_profile_path(account_id: Current.account.id),
                  active: controller_name == "account_profiles" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          </nav>
        </div>
      </header>

      <% if @publication&.persisted? %>
        <nav class="pubnav">
          <div class="pubnav-inner">
            <%= link_to "&larr;".html_safe, account_publications_path(account_id: Current.account.id),
                  class: "pubnav-back", "aria-label": "Back to publications" %>
            <span class="pubnav-name"><%= @publication.name %></span>
            <div class="pubnav-links">
              <%= nav_link_to "Games", account_publication_today_path(publication_id: @publication.id),
                    active: controller_name == "todays" || controller_path.include?("games") %>
              <%= nav_link_to "Sponsorship", account_publication_prizes_path(publication_id: @publication.id),
                    active: controller_path == "publications/prizes" || controller_path == "publications/sponsors" %>
              <%= nav_link_to "Library", account_publication_words_path(publication_id: @publication.id),
                    active: controller_path.include?("words") && !controller_path.include?("games") %>
              <%= nav_link_to "Analytics", account_publication_analytics_path(publication_id: @publication.id), active: controller_name == "analytics" %>
              <%= nav_link_to "Setup", edit_account_publication_path(id: @publication.id), active: controller_path == "publications" && action_name == "edit" %>
            </div>
          </div>
        </nav>
      <% end %>
    <% end %>

    <main class="admin-main">
      <% if authenticated? && Current.account&.deactivated? %>
        <div class="flash flash-alert">This account is deactivated; members can't access it. Reactivate it from the People page.</div>
      <% end %>
      <% if authenticated? && Current.account && @publication&.persisted? %>
        <%= render "publications/trial_banner", publication: @publication %>
      <% end %>
      <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
