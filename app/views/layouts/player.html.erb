<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @publication ? "#{@publication.name} Bingo" : "Newsletter Bingo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#F59E0B">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "player", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="player" <% if @publication %>style="<%= brand_style(@publication) %>"<% end %>>
    <main class="player-main">
      <% if flash[:claim_notice].present? %>
        <div class="claim-notice"><%= flash[:claim_notice] %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="powered-by">
      Powered by Newsletter Bingo
    </footer>
  </body>
</html>
