<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
  </head>

  <%# Styles are inline: email clients strip <style> blocks. Values mirror
      the app's slate palette in application.css. %>
  <body style="margin: 0; padding: 32px 16px; background: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a; line-height: 1.5;">
    <div style="max-width: 480px; margin: 0 auto;">
      <div style="font-size: 16px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 16px;">
        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: #059669;"></span>
        Daily Bingo
      </div>

      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 24px;">
        <%= yield %>
      </div>

      <p style="color: #94a3b8; font-size: 13px; margin: 16px 0 0;">
        Sent by Daily Bingo
      </p>
    </div>
  </body>
</html>
