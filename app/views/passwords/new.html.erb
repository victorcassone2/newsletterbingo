<div class="auth-wrap">
  <h1 class="auth-title">Forgot your password?</h1>
  <div class="card">
    <p class="small muted">Enter your email address and we&rsquo;ll send you reset instructions.</p>
    <%= form_with url: passwords_path do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address] %>
      </div>
      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    <% end %>
    <p class="small muted" style="margin-top: 1rem;"><%= link_to "Back to sign in", new_session_path %></p>
  </div>
</div>
