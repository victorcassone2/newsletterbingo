<div class="auth-wrap">
  <%= image_tag "logo.svg", alt: "Newsletter Bingo", class: "auth-logo" %>
  <h1 class="auth-title">Sign in</h1>
  <div class="card">
    <%= form_with url: session_path do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address] %>
      </div>
      <div class="field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>
      <%= form.submit "Sign in", class: "btn btn-primary" %>
    <% end %>
    <p class="small muted" style="margin-top: 1rem;">
      <%= link_to "Forgot password?", new_password_path %> ·
      <%= link_to "Create an account", new_registration_path %>
    </p>
  </div>
</div>
