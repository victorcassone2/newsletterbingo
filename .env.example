# Copy to .env and fill in real values. .env is gitignored.
# Production values live in the deploy's real ENV.

# --- Stripe (publication subscriptions) ---
# Locally these are the "Newsletter Bingo" account's SANDBOX values
# (Dashboard -> Newsletter Bingo sandbox -> Developers -> API keys).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to
# localhost:3000/webhooks/stripe` (printed as whsec_... when it starts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BINGO_PRICE_ID=
